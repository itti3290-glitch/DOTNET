<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true">

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <!-- CorrelationId comes from the logging scope opened in CorrelationIdMiddleware. -->
  <variable name="layout"
            value="${longdate}|${level:uppercase=true:padding=-5}|${scopeproperty:CorrelationId:whenEmpty=-}|${logger:shortName=true}|${message} ${exception:format=tostring}" />

  <targets>
    <target xsi:type="File" name="file"
            fileName="${basedir}/logs/library-${shortdate}.log"
            layout="${layout}"
            keepFileOpen="false"
            maxArchiveFiles="14"
            archiveEvery="Day" />
    <target xsi:type="Console" name="console" layout="${layout}" />
  </targets>

  <rules>
    <!-- EF logs handled DB failures (e.g. unique-key races) as Error; we log those ourselves as Warning. -->
    <logger name="Microsoft.EntityFrameworkCore.Update" maxlevel="Fatal" final="true" />

    <!-- Framework noise: warnings and above only. -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />

    <logger name="*" minlevel="Info" writeTo="file" />
    <logger name="*" minlevel="Debug" writeTo="console" />
  </rules>
</nlog>
